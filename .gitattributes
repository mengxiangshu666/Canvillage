# Generated AIGC bundle hashes are byte-exact; keep them stable on every OS.
agent_skills/village-canvas-aigc-knowledge/references/vault-aigc/source/** -text whitespace=cr-at-eol
agent_skills/village-canvas-shotcraft/references/upstream/** -text whitespace=cr-at-eol

# CI and Linux operations scripts must stay executable with LF line endings.
*.sh text eol=lf

# Public source exports keep development records in the private workspace.
/AGENTS.md export-ignore
/PROJECT_LAYOUT.md export-ignore
/STATUS.md export-ignore
/MODIFICATIONS.md export-ignore
/DESIGN.md export-ignore
/GOVERNANCE.md export-ignore
