# Village Infinite Canvas newAPI 环境变量示例
#
# 复制为 .env 后填写真实值。
# 服务端只配置 newAPI 网关、newAPI 逻辑模型名、参考媒体 relay 和运行环境参数。
# 上游渠道、真实模型、映射、价格和 token 权限在 newAPI 后台配置。


# =============================================================================
# 1. newAPI 统一网关
# =============================================================================

# 内置 newapi 后台宿主端口（仅 docker compose 生效）。容器内固定 3000，这里只改宿主映射。
# 默认 3000；端口冲突时改成别的（例如 30000）。
# ST_NEWAPI_PORT=3000

# 统一中转站的运行地址和 token 由网页「设置 → 模型配置」保存到本机
# settings.db；本地 NewAPI 由配置向导自动创建运行 token。

# CE 本地 NewAPI 配置向导。数据库固定使用本机 SQLite，无需填写 DSN 或路径。
NEWAPI_PROVISIONER_ENABLED=true

# NewAPI 管理地址，不带 /v1；用于 /api/channel/ 和 /api/token/ 管理接口。
NEWAPI_ADMIN_BASE_URL=http://127.0.0.1:3000

NEWAPI_PROVISIONER_INIT_TIMEOUT_MS=120000
NEWAPI_RELAY_TOKEN_NAME=village-canvas-ce-runtime

# 原创单集入口（original_seed -> ep000）总开关；关闭后不会回退到小说导入链路。
NOVELVIDEO_ORIGINAL_MODE_ENABLED=true

# 是否让 newAPI 文本模型客户端读取系统代理。默认 true。
# 本地 Surge 系统代理影响内网 newAPI 时可设为 false。
# NEWAPI_TEXT_TRUST_ENV=false

# newAPI 文本模型 HTTP 超时时间，单位秒。
NEWAPI_TEXT_TIMEOUT_SECONDS=120

# 村长 Agent 聊天模型。地址和密钥始终跟随当前选中的模型网关。


# =============================================================================
# 1.1 画布 Agent Tavily 搜索（可选；Key 只在本地受保护文件/环境变量中读取）
# 多 Key 文件：每行一个 tvly-...；当前工作站可指向 E:\网盘下载\Tavily.txt。
# TAVILY_KEYS_FILE=
# TAVILY_API_KEYS=
# TAVILY_API_KEY=
# TAVILY_API_URL=https://api.tavily.com/search
# TAVILY_TIMEOUT_SECONDS=20
# TAVILY_TOTAL_TIMEOUT_SECONDS=30
# TAVILY_MAX_ATTEMPTS=3
# TAVILY_MAX_CONCURRENCY=4
# TAVILY_MIN_INTERVAL_SECONDS=0.15
# TAVILY_FAILURE_COOLDOWN_SECONDS=10
# TAVILY_CACHE_TTL_SECONDS=300
# TAVILY_CACHE_SIZE=128


# 2. newAPI 参考媒体 OSS relay
# =============================================================================

# 本地参考图需要先上传到 OSS relay，再把短期签名 URL 传给 newAPI/上游。
# CE 前端保存 OSS relay 配置后，本地 SQLite 配置优先生效。
MEDIA_RELAY_PROVIDER=aliyun_oss

# 签名 URL 默认有效期，单位秒。CE 前端保存后，本地 SQLite 配置优先生效。
MEDIA_RELAY_TTL_SECONDS=1800

# relay bucket 固定给 newAPI 参考媒体使用。CE 前端保存后，本地 SQLite 配置优先生效。
OSS_RELAY_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_RELAY_BUCKET=village-canvas-relay
OSS_RELAY_AK=
OSS_RELAY_SK=

# 可选：使用 Cloudinary 作为参考媒体 relay。将 MEDIA_RELAY_PROVIDER 设为 cloudinary 后生效。
CLOUDINARY_RELAY_CLOUD_NAME=
CLOUDINARY_RELAY_API_KEY=
CLOUDINARY_RELAY_API_SECRET=
CLOUDINARY_RELAY_FOLDER=


# =============================================================================
# 3. Cognee 知识图谱
# =============================================================================

# 导入小说 / cognify / memify 使用的 LLM。
COGNEE_LLM_MODEL=DC-cognee-LLM

# 留空表示不向 newAPI 透传 reasoning_effort。
COGNEE_LLM_THINKING_LEVEL=high

# 跳过 Cognee 启动连接预检，真实请求仍会走 newAPI。
COGNEE_SKIP_CONNECTION_TEST=true

# 小说导入前并行探测 LLM 与 embedding 的超时和成功缓存时间（秒）。
# 探测失败会在清理旧图谱前终止，避免任务运行到中途才发现中转通道缺失。
COGNEE_GATEWAY_HEALTH_TIMEOUT_SECONDS=20
COGNEE_GATEWAY_HEALTH_TTL_SECONDS=60

# Cognee 启动和旧路径使用的默认模型名。项目实际请求模型由各自
# project_config.json 的 cognee_embedding_model 决定：官方历史项目使用 v1，
# 官方新项目使用 v2，CE 自定义 newAPI 项目使用无后缀兼容模型名。
COGNEE_EMBEDDING_MODEL=DC-cognee-embedding
# Cognee 启动和无项目上下文旧路径的默认维度。项目实际维度由
# project_config.json 的 cognee_embedding_dimension 决定。
COGNEE_EMBEDDING_DIM=1024

# 每次小说导入 pipeline 的上游在途请求上限。多个同时导入的 pipeline 会分别计算。
# LLM 的实体/关系抽取与摘要共享同一个并发额度。
COGNEE_LLM_CONCURRENCY=2
# Embedding 并发限制当前仅适用于经 newAPI/custom LiteLLM 发出的请求；其他 provider 会记录绕过日志。
COGNEE_EMBEDDING_BATCH_CONCURRENCY=4

# Cognee embedding 单次请求文本条数。官方默认使用 10，兼容 Qwen / 阿里等低 input 上限模型。
# 如果上游 embedding 模型支持更大批量，可以按需调高。
EMBEDDING_BATCH_SIZE=10

# =============================================================================
# 4. newAPI 文本模型
# =============================================================================

# 小树成长记忆蒸馏。留空时复用模型中心默认文字模型；也可填写一个
# 已保存的 direct/<id>，只切换成长角色的模型，不复制 URL/Key 或新建渠道。
GROWTH_DISTILLER_ENABLED=1
GROWTH_DISTILLER_MODEL=
GROWTH_DISTILLER_AUTO_TEXT_MODEL=1
GROWTH_DISTILLER_THINKING_LEVEL=high
GROWTH_DISTILLER_TIMEOUT_SECONDS=180
GROWTH_DISTILLER_LEASE_MARGIN_SECONDS=30
GROWTH_DISTILLER_MAX_ATTEMPTS=4

# 镜头页 / AI 优化提示词。
GLOBAL_VIDEO_OPTIMIZER_MODEL=DC-video-prompt-optimizer-LLM
GLOBAL_VIDEO_OPTIMIZER_THINKING_LEVEL=none

# 镜头页 / Seedance 2.0 面板 / AI 优化。
SEEDANCE2_PROMPT_COMPOSER_MODEL=DC-seedance2-prompt-composer-LLM
SEEDANCE2_PROMPT_COMPOSER_THINKING_LEVEL=none

# 草图 / AI 检测身份与道具颜色标记。
GLOBAL_VIDEO_IDENTITY_DETECTOR_MODEL=DC-video-identity-detector-LLM
GLOBAL_VIDEO_IDENTITY_DETECTOR_THINKING_LEVEL=none

# 剧集详情 / AI 规划身份 / 出场角色筛选。
IDENTITY_PLANNER_CAST_MODEL=DC-identity-cast-planner-LLM
IDENTITY_PLANNER_CAST_THINKING_LEVEL=none

# 剧集详情 / AI 规划身份 / 默认身份与其他身份分析。
IDENTITY_PLANNER_ANALYSIS_MODEL=DC-identity-analysis-planner-LLM
IDENTITY_PLANNER_ANALYSIS_THINKING_LEVEL=none

# 剧集详情 / AI 规划身份 / 新身份服装造型描述。
IDENTITY_PLANNER_APPEARANCE_MODEL=DC-identity-appearance-writer-LLM
IDENTITY_PLANNER_APPEARANCE_THINKING_LEVEL=none

# 剧集详情 / 逐行生成。
LITERAL_BEAT_META_MODEL=DC-literal-beat-meta-LLM
LITERAL_BEAT_META_THINKING_LEVEL=none
# 单次并行生成的 beat 数（1-6）与单批超时时间（秒）。
LITERAL_BEAT_META_BATCH_SIZE=4
LITERAL_BEAT_META_TIMEOUT_SECONDS=150

# 场景库 / 从图谱构建 / 场景解析、规范化与 environment_prompt 生成。
SCENE_BUILD_MODEL=DC-scene-builder-LLM
SCENE_BUILD_THINKING_LEVEL=none

# 剧集详情 / 规划场景。
EPISODE_SCENE_PLANNER_MODEL=DC-episode-scene-planner-LLM
EPISODE_SCENE_PLANNER_THINKING_LEVEL=none

# 剧集详情 / 规划道具。
EPISODE_PROP_PLANNER_MODEL=DC-episode-prop-planner-LLM
EPISODE_PROP_PLANNER_THINKING_LEVEL=none

# LibTV 官方 CLI 路径（可选；留空时自动发现 ~/.libtv/libtv[.exe]）。
LIBTV_CLI_PATH=

# Freezone / 图片与视频节点模型专属提示词优化。显式设置时覆盖 Seedance 专用路由。
FREEZONE_PROMPT_OPTIMIZER_MODEL=deepseek-v4-flash
# 主文本模型余额不足或暂时失败时按顺序尝试的备用模型，逗号分隔。
FREEZONE_PROMPT_OPTIMIZER_FALLBACK_MODELS=deepseek-v4-flash
# 是否在提示词优化时使用参考图视觉分析。
FREEZONE_PROMPT_OPTIMIZER_VISION=true
# 单次提示词优化最多送入视觉模型的参考图数量。
FREEZONE_PROMPT_OPTIMIZER_VISION_MAX_IMAGES=4
# 是否启用提示词优化研究增强；关闭时保留确定性优化链路。
FREEZONE_PROMPT_OPTIMIZER_RESEARCH=true

# Freezone / 文本提示词中英互译。
FREEZONE_TRANSLATION_MODEL=DC-freezone-translator-LLM

# Freezone / 故事脚本生成；运行时优先使用模型中心，旧部署可显式保留此兼容项。
FREEZONE_STORY_SCRIPT_MODEL=DC-freezone-story-script-writer-LLM

# Freezone 画布 payload 上限，单位字节。
FREEZONE_CANVAS_PAYLOAD_LIMIT_BYTES=5242880

# 内容改写 / 原文转短视频口播逐行文本。
CONTENT_REWRITER_MODEL=DC-content-rewriter-LLM
CONTENT_REWRITER_THINKING_LEVEL=none

# 剧本规范化。
SCREENPLAY_NORMALIZER_MODEL=DC-screenplay-normalizer-LLM
SCREENPLAY_NORMALIZER_THINKING_LEVEL=none

# 2.0 资产编译 / 基础场景资产校对。
EPISODE_SCENE_RECONCILE_MODEL=DC-episode-scene-reconciler-LLM
EPISODE_SCENE_RECONCILE_THINKING_LEVEL=none

# 2.0 资产编译 / 解说剧场景资产规划。
NARRATED_SCENE_ASSET_MODEL=DC-narrated-scene-asset-planner-LLM
NARRATED_SCENE_ASSET_THINKING_LEVEL=none

# DirectorWorld / Freezone AI 临时道具规划。
STAGING_PROP_MODEL=DC-staging-prop-planner-LLM
STAGING_PROP_THINKING_LEVEL=none
STAGING_PROP_TIMEOUT_SECONDS=120


# =============================================================================
# 5. newAPI 图片模型
# =============================================================================

# LingShan-G2 逻辑模型；image2 类模型会按场景透传 quality。
NEWAPI_IMAGE_MODEL=LingShan-G2

# LingShan-NB-2 逻辑模型；nano-banana/nb 类模型不透传 quality。
NEWAPI_NANOBANANA2_MODEL=LingShan-NB-2

# 启用 LingShan-NB-2；关闭时会自动回退到 LingShan-G2。
NEWAPI_NANOBANANA2_ENABLED=true

# 图片读取上限（秒）；留空默认等待上游结果，可选备用渠道 ID 留空表示禁用。
VILLAGE_CANVAS_IMAGE_READ_TIMEOUT_SECONDS=
# 是否让图片请求读取系统代理。内网/WireGuard 网关建议保持 false。
NEWAPI_IMAGE_TRUST_ENV=false
NEWAPI_IMAGE_FAILOVER_CHANNEL_ID=

# 有参考图时优先使用快速参考参数；关闭可优先最高质量。
NEWAPI_FAST_REFERENCE_MODE=false

# 角色图默认模型。
DEFAULT_CHARACTER_IMAGE_SELECTION=newapi_gpt_image2

# 镜头草图默认模型。
DEFAULT_SKETCH_IMAGE_SELECTION=newapi_gpt_image2

# 镜头 render 默认模型。
DEFAULT_RENDER_IMAGE_SELECTION=newapi_gpt_image2

# 项目资产 / 道具三视图参考图 reference_3view.png。
PROP_REF_IMAGE_PROVIDER=newapi
PROP_REF_IMAGE_MODEL=LingShan-G2

# 项目资产 / 源图 master.png，纯文本生成。
SCENE_MASTER_IMAGE_PROVIDER=newapi
SCENE_MASTER_IMAGE_MODEL=LingShan-NB-2

# 项目资产 / reverse_master.png，使用 master.png 作为参考图。
SCENE_REVERSE_MASTER_IMAGE_PROVIDER=newapi
SCENE_REVERSE_MASTER_IMAGE_MODEL=LingShan-NB-2

# 项目资产 / pano_360.png，使用 master/reverse 参考图，2:1 全景。
SCENE_360_IMAGE_PROVIDER=newapi
SCENE_360_IMAGE_MODEL=LingShan-G2


# =============================================================================
# 6. 图像基础参数
# =============================================================================

IMAGE_DEFAULT_WIDTH=1440
IMAGE_DEFAULT_HEIGHT=2560
IMAGE_DEFAULT_STYLE=chinese_period_drama


# =============================================================================
# 7. newAPI 视频模型
# =============================================================================

# 默认视频生成后端。
VIDEO_BACKEND=newapi_sd2.0-720p-fast

# 可选：把视频生成独立路由到兼容 OpenAI 的视频专线；文本、图像、嵌入与 Agent
# 仍继续使用 NEWAPI_BASE_URL。不要把真实密钥提交到仓库。
# NEWAPI_VIDEO_BASE_URL=https://VIDEO_GATEWAY.example/v1
# NEWAPI_VIDEO_API_KEY=
# NEWAPI_VIDEO_API_KEY_FILE=state/video-api-key.txt
# NEWAPI_VIDEO_DEFAULT_BASE_URL=https://newapi.prompt-hubs.com/v1
# NEWAPI_VIDEO_CREATE_PATH=/videos
# 视频提交和下载的独立超时；提交保持较短，下载允许上游已完成产物缓慢回传。
NEWAPI_VIDEO_HTTP_TIMEOUT_SECONDS=45
NEWAPI_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=300
# 已提交视频的只读结果恢复地址；为空时仅使用提交网关。
VILLAGE_CANVAS_VIDEO_RESULT_FALLBACK_BASE_URL=
# 兼容旧部署的公共结果恢复地址；新部署优先使用上面的 VILLAGE_CANVAS_ 变量。
HK_API_PRIMARY=

# 页面可选的 newAPI 视频模型。
NEWAPI_VIDEO_MODELS=village-canvas-video

# 默认视频模型。
DEFAULT_VIDEO_MODEL=village-canvas-video
NEWAPI_VIDEO_MODEL=village-canvas-video

# 默认视频分辨率。
NEWAPI_VIDEO_RESOLUTION=480p
NEWAPI_VIDEO_DURATION_BOUNDS=sd2.0-fast-15s:15-15,sd2.0-15s:15-15

# auto 表示按模型和 beat 类型决定是否生成同步音频。
NEWAPI_VIDEO_GENERATE_AUDIO=auto

# Firefly Seedance2 等模型可选的人脸自动优化开关。
NEWAPI_VIDEO_AUTO_FACE=true
VILLAGE_CANVAS_ALLOW_EXPLICIT_VIDEO_MODEL=true
# Freezone 视频任务的专用本地等待上限（秒）；留空时复用 ST_PROJECT_TASK_TIMEOUT_S。
ST_PROJECT_VIDEO_TASK_TIMEOUT_S=

# 可选：将浏览器操作记录蒸馏为运行时 Skill。为空时沿用统一中转站配置。
SKILLS_DISTILL_MODEL=deepseek-v4-flash
SKILLS_LLM_BASE=
SKILLS_LLM_KEY=

# 支持 generate_audio 的视频模型。
NEWAPI_VIDEO_AUDIO_MODELS=seedance-1.5-pro,seedance-2.0,seedance-2.0-fast,seedance-2.0-value,seedance-2.0-fast-value

# 各视频模型允许的 duration 范围，单位秒。
NEWAPI_VIDEO_DURATION_BOUNDS=seedance-1.0-pro-fast:2-12,seedance-1.5-pro:4-12,seedance-2.0:4-15,seedance-2.0-fast:4-15,seedance-2.0-value:4-15,seedance-2.0-fast-value:4-15,happyhorse-1.0:3-15


# =============================================================================
# 8. newAPI 音频模型
# =============================================================================

# beat 音频生成使用 IndexTTS2；参考声线按 v2.0 逻辑传入。
INDEXTTS2_PROVIDER=newapi
INDEXTTS2_NEWAPI_MODEL=index-tts-2

# 音频生成 HTTP 超时时间，单位秒。
INDEXTTS2_TIMEOUT_SECONDS=1800


# =============================================================================
# 9. 视频基础参数
# =============================================================================

VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_BITRATE=4M


# =============================================================================
# 10. UI 配置
# =============================================================================


# Director viewer 对浏览器可访问的地址。
# 局域网协作时改为本机 LAN IP，例如 http://192.168.2.206:9024。
DIRECTOR_VIEWER_URL=http://127.0.0.1:9024

# operator 操作口令：护「导出提示词」与「图像生成防护闸」。
# 必须设为你自己的非默认值；留空 = 这些受护动作一律拒绝(无公开默认口令)。
PROMPT_EXPORT_PASSWORD=change_me

# 版本/功能更新通知。false = 完全关闭更新源，也不读包内更新说明。
RELEASE_NOTIFICATIONS_ENABLED=true

# 默认不访问远程版本服务；需要时只填写村长无限画布自己的 Releases API。
VILLAGE_CANVAS_RELEASE_FEED_URL=
VILLAGE_CANVAS_RELEASE_FEED_TOKEN=


# =============================================================================
# 11. 输出目录
# =============================================================================

NOVELVIDEO_OUTPUT_DIR=output

# 任务运行历史保留时间（秒），默认 30 天。
NOVELVIDEO_TASK_RUN_HISTORY_TTL=2592000
