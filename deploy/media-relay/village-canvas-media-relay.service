[Unit]
Description=Village Infinite Canvas transient media relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/village-canvas-media-relay.env
ExecStart=/usr/bin/python3 /opt/village-canvas-media-relay/server.py
Restart=always
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/village-canvas-media

[Install]
WantedBy=multi-user.target
