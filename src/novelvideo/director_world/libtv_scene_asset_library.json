{
  "_meta": {
    "name": "LibTV Director Console 3D Asset Library",
    "source": "liblib.tv chunk 1pw97ep85si5l.js (director_img_to_scene prompt + scene importer)",
    "extracted_at": "2026-09-01",
    "license_note": "Extracted for internal research / interoperability. Contains functional parameter dictionaries only.",
    "coordinate_system": {
      "handedness": "right-handed, Y-up",
      "unit": "1 unit = 1 meter",
      "adult_height_m": 1.75,
      "ground": "Y=0 (standing characters/props have position.y=0)",
      "facing": "+Z toward camera/viewer, +X toward screen right",
      "origin": "near the ground contact point of the main subject"
    },
    "spacing": {
      "row_x_m": 1.5,
      "depth_z_m": 1.5
    }
  },

  "bodyTypes": [
    {"id": "mannequin", "label": "标准男性素体", "height_m": 1.75},
    {"id": "female",     "label": "标准女性素体", "height_m": 1.75},
    {"id": "muscular",   "label": "健壮体型（肌肉发达成年男性）", "height_m": 1.75},
    {"id": "slim",       "label": "纤细体型", "height_m": 1.75},
    {"id": "broad",      "label": "宽厚体型（敦实成年男性）", "height_m": 1.75},
    {"id": "teen",       "label": "少年体型", "height_m": 1.5},
    {"id": "child",      "label": "儿童体型", "height_m": 1.1},
    {"id": "chibi",      "label": "Q版二头身", "height_m": null}
