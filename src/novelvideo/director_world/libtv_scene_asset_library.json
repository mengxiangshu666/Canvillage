  "jointSchema": {
    "_note": "Units = degrees. Standing = 0 baseline. l_/r_ = the character's OWN left/right, NOT viewer's. When facing camera, l_arm appears on screen RIGHT.",
    "body":  {"fields": ["bend", "turn", "tilt"], "semantics": "bend=forward+/backward-, turn=left+/right-, tilt=left+/right-"},
    "torso": {"fields": ["bend", "turn", "tilt"], "semantics": "same as body"},
    "head":  {"fields": ["nod", "turn", "tilt"], "semantics": "nod=up+/down-"},
    "l_arm": {"fields": ["raise", "straddle", "turn"], "range": {"raise": [-30, 180]}, "rest": {"raise": -5}},
    "r_arm": {"fields": ["raise", "straddle", "turn"], "range": {"raise": [-30, 180]}, "rest": {"raise": -5}},
    "l_elbow": {"fields": ["bend"], "range": {"bend": [0, 150]}},
    "r_elbow": {"fields": ["bend"], "range": {"bend": [0, 150]}},
    "l_leg":  {"fields": ["raise", "straddle", "turn"], "semantics": "raise=forward+/backward-"},
    "r_leg":  {"fields": ["raise", "straddle", "turn"], "semantics": "raise=forward+/backward-"},
    "l_knee": {"fields": ["bend"], "range": {"bend": [0, 150]}},
    "r_knee": {"fields": ["bend"], "range": {"bend": [0, 150]}},
    "constraints": [
      "Both feet planted => l_leg/r_leg.raise ~0 and knee.bend ~0",
      "Mirrored poses: left/right share raise/straddle/bend values, turn takes opposite sign",
      "Match amplitude to the source image (no universally conservative near-zero values)"
    ]
  },

  "poseLibrary": {
    "_notation": "body/torso=[bend,turn,tilt] head=[nod,turn,tilt] arm=[raise,straddle,turn] elbow/knee=[bend] leg=[raise,straddle,turn]; unspecified joints ~0",
    "_usage": "Pick the closest base pose by 'what is the character doing', then only fine-tune joints that differ from the image. For left-handed variants, swap l_/r_ values.",
    "poses": {
      "stand":       {"label": "站立",   "head": [-10,0,0], "l_arm": [-5,12,0], "r_arm": [-5,14,0], "l_elbow": [15], "r_elbow": [15]},
      "walk":        {"label": "行走",   "torso": [3,5,0], "l_arm": [40,9,0], "r_arm": [-8,27,-4], "l_elbow": [37], "r_elbow": [26], "l_leg": [-10,0,0], "r_leg": [36,-2,0], "l_knee": [22], "r_knee": [41]},
      "run":         {"label": "跑步",   "body": [-2,0,0], "l_arm": [-26,23,14], "r_arm": [23,14,19], "l_elbow": [60], "r_elbow": [89], "l_leg": [50,0,0], "r_leg": [-20,0,0], "l_knee": [18], "r_knee": [36]},
      "sit":         {"label": "坐姿",   "body": [-5,0,0], "torso": [5,0,0], "l_elbow": [80], "r_elbow": [80], "l_leg": [90,5,0], "r_leg": [90,5,0], "l_knee": [90], "r_knee": [90]},
      "crouch":      {"label": "蹲下",   "torso": [45,0,0], "head": [-15,0,0], "l_arm": [39,8,26], "r_arm": [20,15,30], "l_elbow": [87], "r_elbow": [100], "l_leg": [100,15,16], "r_leg": [90,15,16], "l_knee": [104], "r_knee": [97]},
      "one_knee":    {"label": "单膝跪", "torso": [21,0,0], "l_leg": [90,0,4], "r_leg": [27,0,0], "l_knee": [74], "r_knee": [89]},
      "hands_hips":  {"label": "叉腰",   "l_arm": [15,31,-9], "r_arm": [21,31,3], "l_elbow": [80], "r_elbow": [80]},
      "arms_crossed":{"label": "抱臂",   "l_arm": [7,22,17], "r_arm": [8,22,39], "l_elbow": [107], "r_elbow": [107]},
      "wave":        {"label": "招手(右手)", "head": [-5,15,5], "r_arm": [62,-10,90], "r_elbow": [94]},
      "point":       {"label": "指向(右手)", "r_arm": [90,0,0], "r_elbow": [0]},
      "phone":       {"label": "看手机", "head": [17,0,0], "l_arm": [55,-10,-4], "r_arm": [24,-10,-13], "l_elbow": [89], "r_elbow": [43]},
      "push":        {"label": "双手前推", "torso": [19,0,0], "l_arm": [100,6,5], "r_arm": [101,11,0], "l_elbow": [14], "r_elbow": [0]},
      "bow":         {"label": "鞠躬",   "torso": [45,0,0], "head": [20,0,0]},
      "think":       {"label": "思考(手托下巴)", "head": [10,-10,5], "r_arm": [87,-10,90], "r_elbow": [122]}
    }
  },

