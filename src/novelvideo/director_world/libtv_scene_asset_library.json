  "propRules": {
    "default_size_m": 1.0,
    "anchor": "geometry center at origin (so a 1m cube needs position.y=0.5)",
    "placement": "grounded props => position.y=0; set (x,z) by base contact point; align heading with rotation.y",
    "scale": "default {x:1,y:1,z:1}; only change when the source image clearly shows oversized/undersized",
    "fallback": "for objects not in the list, approximate with mesh_* primitives"
  },

  "rotationRules": {
    "axis": "rotation.y controls heading (euler degrees)",
    "values": {
      "0": "facing camera (+Z)",
      "90": "facing right (+X)",
      "-90": "facing left (-X)",
      "180": "away from camera (-Z)"
    },
    "image_cues": [
      "full face / chest visible => y~0",
      "profile only => y~±90",
      "back of head / back => y~180",
      "in-between => diagonal (e.g. ±45, ±135)"
    ],
    "multi_character": [
      "two characters facing each other: one y~0, other y~180",
      "side by side same direction: same y",
      "circle / huddle: each faces the center"
    ]
  },

  "cameraSpec": {
    "fields": {
      "position": "camera location in meters; +Z front, +X right, Y up; usually on the subject's +Z side",
      "lookAt": "target point; usually torso/face height (y~1.2-1.6)",
      "fov": "field of view in degrees, ~15-90"
    },
    "inference_from_image": [
      "horizon high in frame => high angle (camera higher, looking down)",
      "horizon low => low angle (camera lower, looking up)",
      "centered => eye level",
      "stronger convergence of ground/walls => closer camera or wider lens",
      "subject fills more of frame => closer / longer focal (smaller fov)"
    ],
    "presets": {
      "eye_level": {"position": {"y": 1.2}, "note": "1.2-1.7"},
      "high_angle": {"position": {"y": 5}, "note": "raise 5-12, lower lookAt.y"},
      "low_angle": {"position": {"y": 0.3}, "note": "lower 0.3-0.8, raise lookAt.y"}
    },
    "shot_sizes": {
      "wide":       {"distance_z": 8, "fov": [55, 70]},
      "medium":     {"distance_z": 4, "fov": 50},
      "close_up":   {"distance_z": 2, "fov": 35}
    },
    "fallback": {"position": {"x": 0, "y": 1.5, "z": 4}, "lookAt": {"x": 0, "y": 1.2, "z": 0}, "fov": 50}
  },

  "imageBBox": {
    "required": true,
    "format": {"x1": "0-1", "y1": "0-1", "x2": "0-1", "y2": "0-1"},
    "origin": "top-left (x1,y1), bottom-right (x2,y2)",
    "units": "normalized fractions of the whole image, NOT pixels",
    "constraints": ["x1 < x2", "y1 < y2", "box visible body region even when occluded", "never box multiple people into one bbox"]
  },

  "characterGroups": {
    "purpose": "batch-select & move crowds in the director console",
    "format": {"label": "中文 label", "members": "array of indices into characters[] (0-based)"},
    "constraints": [
      "a group needs at least 2 characters, else ignored",
      "a character must not appear in multiple groups",
      "protagonists that need individual control stay OUT of groups",
      "omittable when there are no groups"
    ],
    "formations": {
      "row": "one every ~1.5m along X",
      "grid": "~1.5m on both X and Z",
      "arc": "distribute around a center point by radius",
      "depth_rows": "tighter X spacing, larger z for distant rows"
    },
    "example": {"label": "背景人群", "members": [2, 3, 4, 5, 6, 7]}
  },

  "sceneJsonSchema": {
    "characters": [{
