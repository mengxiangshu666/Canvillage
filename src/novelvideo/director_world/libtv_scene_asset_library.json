        "head":  {"nod": -10, "turn": 0, "tilt": 0},
        "l_arm": {"raise": -5, "straddle": 7, "turn": 0},
        "r_arm": {"raise": -5, "straddle": 7, "turn": 0},
        "l_elbow": {"bend": 15}, "r_elbow": {"bend": 15},
        "l_leg": {"raise": 0, "straddle": 0, "turn": 0},
        "r_leg": {"raise": 0, "straddle": 0, "turn": 0},
